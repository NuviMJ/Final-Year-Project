      "required": true,
      "source": "derived_from_drug",
      "description": "",
      "type": "number",
      "min": 21.0,
      "max": 334.0
    },
    "Severe_Side_Effect_Count": {
      "required": true,
      "source": "derived_from_drug",
      "description": "",
      "type": "number",
      "min": 1.0,
      "max": 27.0
    },
    "Drug_Rating": {
      "required": true,
      "source": "derived_from_drug",
      "description": "",
      "type": "number",
      "min": 4.2,
      "max": 9.7
    }
  },
  "class_order": [
    "Low",
    "Medium",
    "High"
  ],
  "class_to_index": {
    "Low": 0,
    "Medium": 1,
    "High": 2
  }
}